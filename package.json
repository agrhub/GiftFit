{
  "name": "giftfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "live2d:fetch": "node scripts/fetch-live2d-model.mjs",
    "voice:assets": "node scripts/copy-ort-web.mjs && node scripts/fetch-supertonic.mjs",
    "voice:smoke": "tsx scripts/voice-smoke.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run build:gate",
    "gate:full": "npm run gate && npm run e2e",
    "build:gate": "next build",
    "e2e": "playwright test",
    "lhci": "node scripts/lhci.mjs",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "seed": "tsx db/seed.ts",
    "youcam:smoke": "tsx scripts/youcam-smoke.ts",
    "youcam:placeholders": "tsx scripts/youcam-placeholders.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@anthropic-ai/sdk": "^0.134.0",
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/speech": "^8.2.1",
    "@google-cloud/storage": "^8.4.0",
    "@google-cloud/text-to-speech": "^7.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "next": "15.5.28",
    "nodemailer": "^10.1.2",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.30.0",
    "pgvector": "^0.3.0",
    "playwright": "^1.64.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.5",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
