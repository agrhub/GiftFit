# Build context for the Cloud Run image (owner: A8, deploy/README.md). Keep in sync with .gcloudignore.
# Secrets: never in the context. Production secrets come from Secret Manager at deploy time.
.env
.env.*
!.env.example

# Installed / generated (rebuilt inside the image)
node_modules
.next
.next/cache
tsconfig.tsbuildinfo
next-env.d.ts
coverage
test-results
playwright-report
blob-report
.lighthouseci
*.log

# Local-only trees: agent workspaces, Python venv, runtime data
.git
.github
.agents
.claude
agent
.venv
.giftfit

# Real recordings of a person's face and the photo inbox stay on the dev machine (ADR-025)
fixtures/youcam/real
data/aurum/photo-inbox

# Docs and screenshots are not needed at runtime
docs
docs/reports/*-shots
/*.html

# Tests are run by the gate before a deploy, not in the image
tests
**/__tests__

# In-browser voice assets: the image build copies/fetches them itself (A13); never upload a local copy
public/voice
