# GiftFit environment template (owner: A8). Copy to .env.local and fill in what you need.
#   cp .env.example .env.local
# Every variable is optional for local development: with this file copied as-is the app runs fully
# in MOCK MODE (no YouCam units, no Claude/Voyage calls, in-memory DB and photo store).
# Never commit .env.local. Never put real values in this file.
# Sources: docs/reports/A1.md, A3.md, A5.md, A10.md; DECISIONS ADR-014/017.

# ---------------------------------------------------------------------------------------------
# YouCam API (A1, lib/youcam/config.ts)
# ---------------------------------------------------------------------------------------------
# Server-side only, never logged. Needed only for real calls and `py scripts/youcam_core.py validate-key`.
YOUCAM_API_KEY=
# 1 = fixtures only, zero network, zero units (recommended everywhere until the credit pool exists).
# 0 = real mode (paid tasks still need YOUCAM_ALLOW_PAID=1). Unset = mock unless YOUCAM_ALLOW_PAID=1.
YOUCAM_MOCK=1
# 1 permits paid tasks. Leave unset/0. Every paid call also passes the cost guard below.
YOUCAM_ALLOW_PAID=0
# Cost guard: optional balance floor (default 0: no judges' reserve) and a per-process spending cap.
YOUCAM_RESERVE_UNITS=0
YOUCAM_MAX_UNITS_PER_RUN=40
# Owner-only real-credit recording switch (lib/youcam/recording.ts). Off by default: the public site spends
# 0 units. With YOUCAM_RECORDING=on, only a browser that opened /owner/recording#t=<token> gets real try-ons
# (also needs YOUCAM_MOCK=0, YOUCAM_ALLOW_PAID=1, a key and STORE=firestore for durable caps).
# With YOUCAM_MOCK=1 the same switch rehearses the owner flow on fixtures (0 units).
# YOUCAM_RECORDING=off
# GIFTFIT_RECORDING_TOKEN=   (>= 32 random characters; a secret)
# Durable cap across days for paid units (default 300 in real mode; 0 disables).
# YOUCAM_TOTAL_UNIT_CAP=300
# Process-wide cap on units committed per UTC day (charged + in flight). Default 150 in real
# mode; 0 disables it; off in mock mode unless set. Over the cap, paid calls are refused
# (audit reason "daily_cap", DailyCapError) and routes answer 503 {"error":"daily_cap_reached"}.
# YOUCAM_DAILY_UNIT_CAP=150
# Standard Webhooks secret (whsec_...) from the YouCam API console, after the webhook URL is registered.
YOUCAM_WEBHOOK_SECRET=
# Jewelry VTO request body variant (A/B/C) until the shape is verified with a real call (ADR-011).
YOUCAM_JEWELRY_BODY_VARIANT=A
# Optional overrides (defaults shown).
# YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# YOUCAM_POLL_INTERVAL_MS=5000
# YOUCAM_MAX_POLLS=60
# YOUCAM_MOCK_LATENCY_MS=0
# YOUCAM_FIXTURES_DIR=fixtures/youcam
# Not used by the app (s2s v2 is Bearer-key only); kept only if your old .env.local has it.
# YOUCAM_SECRET_KEY=

# ---------------------------------------------------------------------------------------------
# Legacy storage (A1, A5). The Cloud Run deployment uses STORE=firestore + GCS_PHOTO_BUCKET (see
# "Storage backend" below and deploy/README.md); these two are only for the older Vercel setup.
# ---------------------------------------------------------------------------------------------
# Neon Postgres (pgvector). Unset = in-memory repositories + JSONL audit/file cache in GIFTFIT_DATA_DIR.
# Format: postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
# Vercel Blob for short-lived recipient photos (TTL <= 1 h). Unset = process-local memory store.
BLOB_READ_WRITE_TOKEN=
# Local audit log / result cache directory. Default .giftfit/ (on Vercel: $TMPDIR/giftfit).
# GIFTFIT_DATA_DIR=.giftfit

# ---------------------------------------------------------------------------------------------
# Privacy & Surprise (A5, A3): REQUIRED in production
# ---------------------------------------------------------------------------------------------
# HMAC key for signed try-on URLs, >= 32 chars. Production refuses to start recipient routes without it;
# dev/test use a random per-process secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GIFTFIT_URL_SIGNING_SECRET=
# Bearer secret for the expiry cron GET /api/recipient/purge-expired (Cloud Scheduler sends it hourly).
CRON_SECRET=
# Secret mixed into decoy seeds. Must be identical on every instance, or the carousel order differs
# between serverless instances (ADR-017). Generate like the signing secret.
FIT_DECOY_SECRET=
# Salt for the HMAC of client IPs (rate limits keep only the hash). Unset = derived from the signing secret.
# GIFTFIT_IP_HASH_SALT=
# Proxy hops in front of the app: the client IP is X-Forwarded-For[len - hops]. Cloud Run: 1.
# GIFTFIT_TRUSTED_PROXY_HOPS=1
# off = no rate limits outside production (local convenience; ignored in production).
# GIFTFIT_RATE_LIMITS=on

# ---------------------------------------------------------------------------------------------
# Claude (Gift Concierge, Fit Report explanations, A10 Tier 3 extraction)
# ---------------------------------------------------------------------------------------------
# Unset = deterministic template explanations and the heuristic extractor (no LLM calls).
ANTHROPIC_API_KEY=
# USD per UTC day across all Claude calls (default 3); 0 or negative disables Claude calls. Over the cap,
# the Concierge and the report fall back to deterministic templates.
# ANTHROPIC_DAILY_USD_CAP=3
# Concierge: 1 = replay a recorded conversation (no key needed). Unset = live with a key, mock without one;
# 0 without a key = the deterministic fallback answer.
# CONCIERGE_MOCK=
# INGEST_CLAUDE_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------------------------------------
# Ingest (A10, lib/ingest/config.ts)
# ---------------------------------------------------------------------------------------------
# Voyage embeddings (voyage-3.5, 1024 dims). Unset = deterministic hash embedder.
VOYAGE_API_KEY=
# 1 = read the committed fixture snapshot instead of crawling (tests, demos).
INGEST_FIXTURE=1
# heuristic | recorded (replay recorded Claude responses). Unset = Claude if ANTHROPIC_API_KEY, else heuristic.
# INGEST_EXTRACTOR=heuristic
# Comma-separated hosts POST /api/ingest may crawl. Empty = only the fixture hosts (INGEST_FIXTURE=1)
# and, outside production, localhost.
INGEST_ALLOWED_HOSTS=
# Optional bearer token required by /api/ingest (recommended in production).
INGEST_ADMIN_TOKEN=
# Public page describing the crawler (sent in the User-Agent); required before any live crawl.
INGEST_INFO_URL=
# INGEST_MAX_PAGES=400

# Store-URL preview (A10, ADR-055: lib/preview, POST /api/preview). Public https URLs only, SSRF-guarded,
# robots.txt honoured, ≤ 30 fetches and ≤ 50 products per preview; previews expire after 24 h.
# off = POST /api/preview answers 503 {"error":"disabled"}.
# PREVIEW_ENABLED=on
# Started previews per IP per UTC day (default 5) and in total per UTC day (default 100). Durable with STORE=firestore.
# PREVIEW_IP_DAILY_CAP=5
# PREVIEW_DAILY_CAP=100
# off = no page snapshot (previews use the neutral GiftFit template instead of the store's own page).
# PREVIEW_SNAPSHOT=on
# e2e only: 1 enables POST /api/preview/seed (fixture store, needs Bearer CRON_SECRET). Never in production.
# PREVIEW_FIXTURE_SEED=

# ---------------------------------------------------------------------------------------------
# Voice (A13, lib/voice/config.ts): Google Cloud Speech-to-Text V2 (chirp_3) and Text-to-Speech
# ---------------------------------------------------------------------------------------------
# Live calls use Application Default Credentials (on Cloud Run: the service account with
# roles/speech.client). Without credentials, or under NODE_ENV=test, the mock engine answers.
# 0 = both voice routes answer 503 voice_unavailable (kill switch).
# VOICE_ENABLED=1
# 1 = force the mock (canned transcript, sine-tone audio); 0 = force live Google calls.
# VOICE_MOCK=
# auto = chirp_3 detects the spoken language (default); fixed = use the widget's UI language.
# VOICE_STT_LANGUAGE=auto
# Daily caps: billed STT audio seconds (default 3600) and TTS characters (default 150000).
# VOICE_STT_DAILY_SECONDS=3600
# VOICE_TTS_DAILY_CHARS=150000
# Per widget session caps (default 12 each).
# VOICE_SESSION_STT_MAX=12
# VOICE_SESSION_TTS_MAX=12
# 0 = no per-request metrics line (it never contains text or audio).
# VOICE_LOG=1

# ---------------------------------------------------------------------------------------------
# Storage backend (A11 / R0): Firestore + private GCS bucket on Cloud Run
# ---------------------------------------------------------------------------------------------
# memory | firestore. Unset/memory = in-process repositories (local dev, tests). firestore = Cloud
# Firestore through Application Default Credentials (no key file in the repo).
STORE=
# Firestore database id (named database, e.g. giftfit-db). Unset = the project's (default) database.
FIRESTORE_DATABASE_ID=
# Private (non-public, uniform bucket-level access) GCS bucket for short-lived recipient photos.
GCS_PHOTO_BUCKET=
# Google Cloud project for Firestore and the Speech-to-Text recognizer path. Unset = resolved through ADC.
# GOOGLE_CLOUD_PROJECT=
# Local runs against real Google services: a service-account key file outside the repo, or use
# `gcloud auth application-default login` instead.
# GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------------------------
# Health / build info
# ---------------------------------------------------------------------------------------------
# Shown in GET /api/health "version" (Cloud Run's K_REVISION wins when present).
# GIT_SHA=

# ---------------------------------------------------------------------------------------------
# Email (A12, lib/email): gift-card and "Fit Report ready" emails
# ---------------------------------------------------------------------------------------------
# Nothing is sent unless EMAIL_SEND_ENABLED=1. Under NODE_ENV=test or YOUCAM_MOCK=1, or with any
# config missing, the console provider is used: it logs only the recipient DOMAIN and the subject.
# Check SMTP login without sending:  npx tsx scripts/email-verify.ts
# smtp | resend | console. Unset = smtp when SMTP_HOST is set, else console.
EMAIL_PROVIDER=
# Kill-switch: 1 = real providers may send. Anything else = console only. Keep unset until approved.
EMAIL_SEND_ENABLED=
# SMTP (nodemailer). TLS certificate + hostname checks are always on; port 465 = implicit TLS
# (SMTP_SECURE=true), other ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=
# true | false. Unset = true on port 465, else false (STARTTLS, required).
SMTP_SECURE=
# Server-side only, never logged. Next.js expands "$NAME" inside .env values: write a literal
# "$" in a password as "\$" (scripts/email-verify.ts uses the same loader, so it will tell you).
SMTP_USER=
SMTP_PASS=
# Resend (only with EMAIL_PROVIDER=resend). Server-side only, never logged.
RESEND_API_KEY=
# Sender: bare address (the From address must be allowed by the SMTP account / Resend domain).
EMAIL_FROM=
# Display name for From. Unset = GiftFit.
EMAIL_FROM_NAME=
# Optional default Reply-To (abuse reports arrive here: the footer says "reply to this email").
EMAIL_REPLY_TO=
# Origin used for every link in emails, e.g. https://giftfit.example.com (no path). Unset = the
# request origin, else http://localhost:3000. SET IT IN PRODUCTION (the Host header is caller-controlled).
APP_BASE_URL=

# --- Embeddable gift assistant widget (A6, ADR-046) ---------------------------------------------
# Store origins allowed to embed the widget frame /w (comma or space separated), e.g.
# "https://giftfit-demo-store-xyz.a.run.app https://shop.example". Read at REQUEST time by middleware.ts
# (frame-ancestors CSP) and by /w (postMessage allow-list); GiftFit's own origin is always allowed.
# Unset or "*" = any origin (local/demo convenience). Set it in production.
GIFTFIT_WIDGET_ORIGINS=
# Optional Facebook app id: Messenger share uses the web Send Dialog; unset = fb-messenger:// (mobile).
GIFTFIT_FB_APP_ID=
# Origin of the demo store (the only storefront, demo-store/), read at request time: the home page's
# "Open the demo store" button and the 308s from old storefront paths (/p/…, /c/…, /cart, /plugin-demo/…).
# Unset = the deployed giftfit-demo-store service. Locally: http://localhost:4320
GIFTFIT_DEMO_STORE_URL=
# Set on the demo store itself (demo-store/server.mjs), not on the app: the GiftFit origin its
# script tag loads giftfit.js from, e.g. http://localhost:3000 or the app's stable Cloud Run URL.
# GIFTFIT_ORIGIN=
# Dev only: 1 = the gift pages use an in-browser mock of the API (no server state).
# NEXT_PUBLIC_GIFTFIT_UI_MOCK=
